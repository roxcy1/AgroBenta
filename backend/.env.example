APP_NAME=AgroBenta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=agrobenta
DB_USERNAME=agrobenta_user
DB_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# Laravel Reverb (WebSocket server) — see the `reverb` service in compose.yaml.
# Generate real credentials (and this block) with `php artisan reverb:install`;
# the values below are placeholders and must be replaced before any deployment.
REVERB_APP_ID=CHANGE_THIS_REVERB_APP_ID
REVERB_APP_KEY=CHANGE_THIS_REVERB_APP_KEY
REVERB_APP_SECRET=CHANGE_THIS_REVERB_APP_SECRET
# Host/port the PHP app uses to reach the Reverb HTTP/WebSocket server.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Bind address for `php artisan reverb:start` (server side).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
#
# Client-facing WebSocket URL (NOT used by Laravel itself — consumed by the
# Flutter/React Echo clients). The `reverb` service in compose.yaml publishes
# container port 8080 as ${REVERB_PORT:-8083} on the host:
#   ws://localhost:8083        local development (Flutter Web / iOS simulator)
#   ws://10.0.2.2:8083         Android emulator
#   ws://<machine-LAN-IP>:8083 physical Android device
# Production must terminate TLS (wss://) in front of Reverb.

FILESYSTEM_DISK=local

# Listing photos disk (functional documentation §4.5, contract D-10).
# `local` writes into storage/app/public/listings (served via `php artisan
# storage:link`); set `s3` to move them to a bucket. When using s3, also set
# AWS_* below and LISTING_PHOTOS_URL to the public base URL of the bucket/CDN.
LISTING_PHOTOS_DRIVER=local
# LISTING_PHOTOS_URL=
# LISTING_PHOTOS_ROOT=

QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Queue connection used by QUEUE_CONNECTION=redis (see config/queue.php).
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default

# `log` writes emails to storage/logs/laravel.log, which is enough for local
# development. A real deployment needs an SMTP service, or password reset codes
# never reach users. Replace the values below with these:
#   MAIL_MAILER=smtp
#   MAIL_HOST=CHANGE_THIS_MAIL_HOST
#   MAIL_PORT=CHANGE_THIS_MAIL_PORT
#   MAIL_USERNAME=CHANGE_THIS_MAIL_USERNAME
#   MAIL_PASSWORD=CHANGE_THIS_MAIL_PASSWORD
#   MAIL_FROM_ADDRESS=CHANGE_THIS_MAIL_FROM_ADDRESS
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Private FastAPI price-prediction service. Keep this URL on the internal
# Docker network; do not expose the service publicly.
PRICE_PREDICTION_URL=http://ml-service:8002
PRICE_PREDICTION_CONNECT_TIMEOUT=2
PRICE_PREDICTION_TIMEOUT=5
PRICE_PREDICTION_CONTRACT_VERSION=1.0

VITE_APP_NAME="${APP_NAME}"

# ── Administrator seed account ─────────────────────────────────────────────
# Consumed by database/seeders/AdminSeeder.php. Change before seeding.

ADMIN_NAME=Administrator
ADMIN_EMAIL=CHANGE_THIS_admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_admin_password

# Google Sign-In (mobile). The OAuth "Web application" client ID the mobile
# app passes as serverClientId. No client secret is needed.
GOOGLE_CLIENT_ID=CHANGE_THIS_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Phone push notifications (Firebase Cloud Messaging). The path to the Firebase
# service account JSON key, relative to the backend folder or absolute. The key
# is a secret: keep it under storage/app (ignored by git), never commit it.
# Leave empty to turn push off; notifications are still shown in the app.
FCM_CREDENTIALS=
# FCM_CREDENTIALS=storage/app/firebase/CHANGE_THIS_service-account.json

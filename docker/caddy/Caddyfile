# Public entry point in production (compose.prod.yaml). Caddy obtains and
# renews the HTTPS certificate for SITE_DOMAIN automatically.
#
#   /api/*, /broadcasting/*, /storage/*  -> nginx -> Laravel
#   /app/*                               -> Reverb (WebSockets)
#   everything else                      -> the built Admin Web (frontend/dist)
#
# Reverb's /apps/* HTTP API is not exposed: Laravel reaches it internally at
# reverb:8080.
{
	servers {
		# When the domain is proxied by Cloudflare (orange cloud), take the
		# visitor's address from CF-Connecting-IP, but only from Cloudflare's
		# published ranges (https://www.cloudflare.com/ips/), so it cannot be
		# spoofed by calling the server directly. Laravel's rate limits depend
		# on it.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	@laravel path /api/* /broadcasting/* /storage/*
	handle @laravel {
		reverse_proxy nginx:80 {
			# The real visitor address, resolved by trusted_proxies above.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /app/* {
		reverse_proxy reverb:8080
	}

	handle {
		root * /srv
		# Vite fingerprints these file names, so they can be cached for good.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Single-page app: unknown paths (/login, /dashboard) load index.html.
		try_files {path} /index.html
		file_server
	}
}

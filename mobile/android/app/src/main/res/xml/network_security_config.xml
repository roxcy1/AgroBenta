<?xml version="1.0" encoding="utf-8"?>
<!--
  AgroBenta Android network security configuration.

  The app talks to a Laravel REST API. Production traffic MUST be HTTPS, so
  cleartext is denied by default in <base-config>.

  Cleartext is permitted only for local development hosts, where the API is
  served over plain HTTP by Nginx on port 8001 in the Docker stack:

    10.0.2.2      the Android emulator's alias for the host machine
    localhost     the host machine, when reached over adb reverse
    127.0.0.1     same, IPv4 form

  This is a development allowance, not a production posture. When a staging or
  production HTTPS host is added, add it to <domain-config> with
  cleartextTrafficPermitted="true" ONLY if it genuinely cannot serve TLS, and
  say so in a comment here.

  See mobile/AGENTS.md and mobile/lib/core/config/app_config.dart.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>

# Copy this file to ".env" (same folder) before first run:
#   cp .env.example .env      (Mac/Linux/WSL)
#   copy .env.example .env    (Windows PowerShell)
#
# This .env is read by compose.yaml itself (for MySQL container env vars).
# It is SEPARATE from backend/.env, which Laravel reads. You'll fill in
# backend/.env with matching values after Laravel is scaffolded.
#
# ⚠️  CHANGE EVERY VALUE BELOW before using this template for your project.

DB_DATABASE=CHANGE_THIS_DATABASE_NAME
DB_USERNAME=CHANGE_THIS_DATABASE_USER
DB_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
DB_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD


# ── Docker Host Ports ─────────────────────────────────────────────────────
# Change these if the ports are already being used on your machine.

APP_PORT=8001
FRONTEND_PORT=5174
PHPMYADMIN_PORT=8082
DB_PORT=33070
REVERB_PORT=8083